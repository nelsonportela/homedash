# Dashboard title (optional, defaults to "HomeDash")
title: "My Personal Dashboard"

# Default theme: "dark" or "light" (optional, defaults to "dark")
default_theme: "dark"

# Group-specific settings (optional)
groups:
  Media:
    color: "#10B981"    # Green accent color
    grid_cols: 6        # Show 6 columns for media apps
  Network:
    color: "#3B82F6"    # Blue accent color
    grid_cols: 4        # Show 4 columns for network apps
  Development:
    color: "#8B5CF6"    # Purple accent color
    grid_cols: 5        # Show 5 columns for dev apps
  Monitoring:
    color: "#F59E0B"    # Orange accent color
    grid_cols: 4        # Show 4 columns for monitoring apps
  Productivity:
    color: "#EF4444"    # Red accent color
    grid_cols: 6        # Show 6 columns for productivity apps

apps:
  menu:
    icon_url: "https://cdn-icons-png.flaticon.com/512/1827/1827933.png"
    title: "Menu Manager"
    group: "Network"
  dozzle:
    icon_url: "https://raw.githubusercontent.com/amir20/dozzle/master/assets/logo.png"
    title: "Docker Logs"
    group: "Monitoring"
  books:
    icon_url: "https://cdn-icons-png.flaticon.com/512/2232/2232688.png"
    title: "Library"
    group: "Media"
  # Example for apps without custom configuration (will use defaults)
  # myapp:
  #   icon_url: "https://example.com/path/to/icon.png"
  #   title: "My Custom Application Name"
  #   group: "Development"
  #   icon_url: "https://example.com/path/to/icon.png"
  #   title: "My Custom Application Name"
  #   group: "Development"
  #
  # Available groups (in display order):
  # - Media
  # - Network  
  # - Development
  # - Monitoring
  # - Other (default if not specified)